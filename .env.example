# Copia a .env.local (Vite lo carga automático, y .gitignore ya lo excluye).
# En Vercel, esta misma variable se configura en Project Settings > Environment Variables.

# URL base de la API (mediruta-api en Render).
# Local: apunta a tu API corriendo en localhost.
# Producción: la URL real de Render, ej. https://mediruta-api.onrender.com
VITE_API_URL=http://localhost:3000

# ── api/enviar-correo.ts (función serverless, NO el frontend Vite) ──
# Sin prefijo VITE_ a propósito: estas nunca deben llegar al bundle del
# navegador. Se configuran solo en Vercel > Project Settings >
# Environment Variables (nunca en .env.local ni acá con el valor real)
# — ver comentario en api/enviar-correo.ts para el porqué de este relay.
# GMAIL_SMTP_APP_PASSWORD es una "contraseña de aplicación" (no la
# contraseña normal de la cuenta) — se genera en
# myaccount.google.com/apppasswords, requiere verificación en 2 pasos.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Secreto compartido con mediruta-api (misma cadena en su
# CORREO_RELAY_SECRET, en Render) — sin esto cualquiera que encuentre
# la URL podría mandar correos desde nuestra cuenta de Gmail.
CORREO_RELAY_SECRET=
